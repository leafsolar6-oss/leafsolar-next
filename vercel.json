{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.leafsolar.ng" }],
      "destination": "https://leafsolar.ng/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.leafsolar.ng" }],
      "destination": "https://leafsolar.ng/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
