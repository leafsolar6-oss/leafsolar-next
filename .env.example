# Copy to .env.local for development; set these in Vercel in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
OTP_FROM_EMAIL="Leaf Solar <no-reply@leafsolar.ng>"
OTP_TO_EMAIL=abodjaneb@gmail.com
CONTACT_TO_EMAIL=hello@leafsolar.ng
NEXT_PUBLIC_SITE_URL=https://leafsolar.ng

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Google Merchant API (server-only; keep the service-account JSON encrypted in Vercel)
GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key":"hidden","client_email":"merchant-api@your-project.iam.gserviceaccount.com"}
# Optional when the credential can access exactly one Merchant Center account.
GOOGLE_MERCHANT_ACCOUNT_ID=
# Optional; must be a verified human Merchant admin. OTP_TO_EMAIL is used only when API-verified as an admin.
GOOGLE_MERCHANT_DEVELOPER_EMAIL=
